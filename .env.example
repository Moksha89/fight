# Public deployment identity
ROOSTERRUN_DOMAIN=live.example.invalid
CANDIDATE=203.0.113.10
# SOCIAL_PREVIEW | APPROVAL_DEMO (demo credits) | REAL_MONEY (live wallets)
ROOSTERRUN_OPERATING_MODE=REAL_MONEY
ROOSTERRUN_DEMO_STARTING_BALANCE=12450

# First-run administrator. Prefer the *_FILE form in production and remove it
# after the first owner is created and MFA is enabled.
ROOSTERRUN_BOOTSTRAP_ADMIN_USERNAME=owner
ROOSTERRUN_BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap_admin_password
ROOSTERRUN_BOOTSTRAP_ADMIN_NAME=Platform Owner

# PostgreSQL DSN is supplied through deploy/production/secrets/database_url.
# Use the primary/cluster endpoint of a managed PostgreSQL service with TLS.
ROOSTERRUN_DATABASE_POOL_SIZE=24

# OTP SMS: "webhook" or "twilio". Configure only the selected provider.
ROOSTERRUN_SMS_PROVIDER=webhook
ROOSTERRUN_SMS_WEBHOOK_URL=https://sms-gateway.example.invalid/otp
ROOSTERRUN_SMS_WEBHOOK_TOKEN_FILE=/run/secrets/sms_webhook_token
# ROOSTERRUN_TWILIO_ACCOUNT_SID=
# ROOSTERRUN_TWILIO_AUTH_TOKEN_FILE=/run/secrets/twilio_auth_token
# ROOSTERRUN_TWILIO_FROM=

# SMTP email delivery
ROOSTERRUN_SMTP_HOST=smtp.example.invalid
ROOSTERRUN_SMTP_PORT=587
ROOSTERRUN_SMTP_USERNAME=alerts@example.invalid
ROOSTERRUN_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
ROOSTERRUN_SMTP_FROM=RoosterRun Alerts <alerts@example.invalid>
ROOSTERRUN_SMTP_STARTTLS=1

# Operations destinations. Comma-separate multiple recipients.
ROOSTERRUN_ALERT_SMS_TO=+910000000000
ROOSTERRUN_ALERT_EMAIL_TO=operations@example.invalid
ROOSTERRUN_ALERT_WEBHOOK_URL=https://alerts.example.invalid/roosterrun
ROOSTERRUN_ALERT_WEBHOOK_TOKEN_FILE=/run/secrets/alert_webhook_token
ROOSTERRUN_REQUIRE_EXTERNAL_ALERTS=1
ROOSTERRUN_USER_SMS_NOTIFICATIONS=0

# HTTPS, concurrency, and worker requirements
ROOSTERRUN_SECURE_COOKIES=1
ROOSTERRUN_TRUST_PROXY=1
ROOSTERRUN_MAX_CONCURRENT_REQUESTS=128
ROOSTERRUN_REQUIRE_STREAMING=1
ROOSTERRUN_REQUIRE_RECORDING=1
ROOSTERRUN_REQUIRE_MEDIA_HEALTH=1
ROOSTERRUN_REQUIRE_POSTGRES=1
ROOSTERRUN_REQUIRE_DATABASE_TLS=1
ROOSTERRUN_REQUIRE_OFFSITE_BACKUP=1
ROOSTERRUN_RECOVERY_STATE_DIR=/restore-state
ROOSTERRUN_REQUIRE_SECRET_ROTATION=1

# SRS WHIP/WHEP, HLS fallback, and DVR recording delivery
ROOSTERRUN_WHIP_BASE_URL=https://live.example.invalid
ROOSTERRUN_WHEP_BASE_URL=https://live.example.invalid
ROOSTERRUN_HLS_BASE_URL=https://live.example.invalid/media
ROOSTERRUN_RECORDING_BASE_URL=https://live.example.invalid/media/recordings
ROOSTERRUN_RECORDING_EXTENSION=flv
ROOSTERRUN_SRS_HOOK_SECRET_FILE=/run/secrets/srs_hook_secret
ROOSTERRUN_SRS_HOOK_SECRET_PREVIOUS_FILE=/run/secrets/srs_hook_secret_previous

# Encrypted off-host restic repository (S3/Spaces-compatible example)
RESTIC_REPOSITORY=s3:https://blr1.digitaloceanspaces.com/example-private-bucket/roosterrun
ROOSTERRUN_BACKUP_INTERVAL_SECONDS=21600

# Grafana is bound to loopback and should be reached through an SSH tunnel.
GRAFANA_ADMIN_USER=admin
