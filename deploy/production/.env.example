ROOSTERRUN_DOMAIN=rooster.example.com
CANDIDATE=203.0.113.10

ROOSTERRUN_BOOTSTRAP_ADMIN_USERNAME=owner
ROOSTERRUN_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-16-character-or-longer-password
ROOSTERRUN_BOOTSTRAP_ADMIN_NAME=Platform Owner

# REAL_MONEY runs live wallets, deposits, withdrawals and settlement.
# Use APPROVAL_DEMO for non-cash demo credits, SOCIAL_PREVIEW to disable payments.
ROOSTERRUN_OPERATING_MODE=REAL_MONEY
ROOSTERRUN_DEMO_STARTING_BALANCE=12450

ROOSTERRUN_SMS_WEBHOOK_URL=https://sms-provider.example/otp
ROOSTERRUN_SMS_WEBHOOK_TOKEN=replace-with-provider-token
ROOSTERRUN_SECURE_COOKIES=1
ROOSTERRUN_REQUIRE_STREAMING=1

ROOSTERRUN_WHIP_BASE_URL=https://rooster.example.com
ROOSTERRUN_WHEP_BASE_URL=https://rooster.example.com
ROOSTERRUN_HLS_BASE_URL=https://rooster.example.com/media
ROOSTERRUN_RECORDING_BASE_URL=https://rooster.example.com/media
ROOSTERRUN_SRS_HOOK_SECRET=replace-with-at-least-32-random-characters
